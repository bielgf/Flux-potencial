function geom = computeGeometry2airfoil(Ndiv, delta_e)

c1 = 0.64;
c2 = 0.34;
d  = 0.02;

% Read NACA 0012 file
filename = sprintf('NACA0012/NACA_10_N_%d.txt', Ndiv);
data = load(filename);
Xbase = [data(:,2) data(:,3)];

% AIRFOIL 1 (horizontal stabilizer) 

X1 = [c1*Xbase(:,1), c1*Xbase(:,2)];

% AIRFOIL 2 (elevator)

Xs = [c2*Xbase(:,1), c2*Xbase(:,2)]; % Scale

R = [cos(delta_e) -sin(delta_e);
     sin(delta_e)  cos(delta_e)]; % Rotate

Xrot = (R * Xs')';

X2 = Xrot;
X2(:,1) = X2(:,1) + c1 + d; % Move d distance

% Airfoils altogether

geom.X = [X1; X2];

geom.c = 1;   % corda total del sistema

figure
plot(Xbase(:,1), Xbase(:,2), 'o-')
axis equal
grid on
title(sprintf('NACA0012 amb %d panells',Ndiv))
xlabel('x'); ylabel('z');